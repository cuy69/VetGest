# Copia este archivo como .env.local y ajusta la URL de la API de VetGest (FastAPI, prefijo /api).
# Expo inserta las variables EXPO_PUBLIC_* al compilar: reinicia `npx expo start` tras cambiarla.
#
# - Simulador iOS o navegador en esta Mac:  http://localhost:8000/api
# - Emulador Android:                       http://10.0.2.2:8000/api
# - Celular con Expo Go (misma wifi):       http://<IP-de-tu-Mac>:8000/api   (p. ej. http://192.168.1.20:8000/api)
# - Backend desplegado (Render):            https://<tu-servicio>.onrender.com/api
EXPO_PUBLIC_API_URL=http://localhost:8000/api
