{
  "expo": {
    "name": "VetGest",
    "slug": "vetgest",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vetgest",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#f7f3ec",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.vetgest.mobile",
      "supportsTablet": true
    },
    "android": {
      "package": "com.vetgest.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0d5953",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "VetGest",
      "lang": "es"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0d5953",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140,
          "dark": {
            "backgroundColor": "#0b2b28"
          }
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "c21b051f-a084-4086-81f2-80746008c94d"
      }
    },
    "owner": "amaui"
  }
}
